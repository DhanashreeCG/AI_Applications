{
  "type": "object",
  "required": [
    "main_topic",
    "sub_topic",
    "instruction_text",
    "images"
  ],
  "additionalProperties": true,
  "properties": {
    "worksheet_type": { "type": "string" },
    "main_topic": { "type": "string", "minLength": 1, "maxLength": 80 },
    "sub_topic": { "type": "string", "minLength": 1, "maxLength": 80 },
    "instruction_text": { "type": "string", "minLength": 1, "maxLength": 220 },
    "content_html": { "type": "string", "minLength": 0, "maxLength": 16000 },
    "activities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "type", "title"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "maxLength": 48 },
          "type": { "type": "string", "maxLength": 40 },
          "title": { "type": "string", "maxLength": 80 },
          "instruction": { "type": "string", "maxLength": 160 },
          "items": { "type": "array", "maxItems": 12 },
          "leftItems": { "type": "array", "maxItems": 6 },
          "rightItems": { "type": "array", "maxItems": 6 },
          "layoutIntent": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "preferredLayout": { "type": "string" },
              "density": { "type": "string" },
              "imageImportance": { "type": "string" }
            }
          }
        }
      }
    },
    "labels": {
      "type": "array",
      "maxItems": 24,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["imageQuery"],
        "additionalProperties": true,
        "properties": {
          "imageQuery": { "type": "string", "minLength": 1, "maxLength": 120 },
          "assetId": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["primary", "option", "matching", "decorative", "outline"]
          },
          "importance": {
            "type": "string",
            "enum": ["high", "normal", "low"]
          },
          "activityId": { "type": "string", "maxLength": 48 }
        }
      }
    }
  }
}
