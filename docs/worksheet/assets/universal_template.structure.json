{
  "type": "object",
  "required": [
    "main_topic",
    "sub_topic",
    "instruction_text",
    "content_html",
    "images"
  ],
  "additionalProperties": true,
  "properties": {
    "worksheet_type": { "type": "string" },
    "main_topic": { "type": "string", "minLength": 1, "maxLength": 80 },
    "sub_topic": { "type": "string", "minLength": 1, "maxLength": 80 },
    "instruction_text": { "type": "string", "minLength": 1, "maxLength": 220 },
    "content_html": { "type": "string", "minLength": 80, "maxLength": 32000 },
    "images": {
      "type": "array",
      "minItems": 4,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["imageQuery"],
        "additionalProperties": true,
        "properties": {
          "imageQuery": { "type": "string", "minLength": 1, "maxLength": 120 },
          "assetId": { "type": "string" }
        }
      }
    }
  }
}
