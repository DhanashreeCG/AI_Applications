generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = ""
  moduleFormat        = "cjs"
}

datasource db {
  provider = "postgresql"
}

model IngestionJob {
  id                     String          @id @default(cuid())
  sourceType             String          @default("GOOGLE_DRIVE")
  rootFolderId           String
  status                 JobState        @default(CREATED)
  totalDiscovered        Int             @default(0)
  totalProcessed         Int             @default(0)
  totalSuccessful        Int             @default(0)
  totalSkipped           Int             @default(0)
  totalFailed            Int             @default(0)
  totalDuplicate         Int             @default(0)
  errorMessage           String?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  mode                   String          @default("FULL")
  expectedGeminiCalls    Int?
  expectedEmbeddingCalls Int?
  estimatedGeminiCostUsd Float?
  estimatedOpenAiCostUsd Float?
  estimatedTotalCostUsd  Float?
  files                  IngestionFile[]

  @@index([status])
  @@index([createdAt])
}

model IngestionFile {
  id                 String              @id @default(cuid())
  jobId              String
  driveFileId        String
  filename           String
  mimeType           String?
  fileSize           BigInt?
  folderPath         String?
  driveFileCreatedAt DateTime?
  status             AssetState          @default(DISCOVERED)
  errorMessage       String?
  assetId            String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assetSource        AssetSource?
  asset              Asset?              @relation(fields: [assetId], references: [id])
  job                IngestionJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attempts           ProcessingAttempt[]

  @@unique([jobId, driveFileId])
  @@index([driveFileId])
  @@index([status])
  @@index([assetId])
}

model Asset {
  id             String              @id @default(cuid())
  contentHash    String              @unique
  mimeType       String
  fileSize       BigInt
  width          Int?
  height         Int?
  s3Bucket       String
  s3ObjectKey    String
  status         AssetState          @default(STORED_IN_S3)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  aiUsages       AiUsage[]
  embeddings     AssetEmbedding[]
  metadata       AssetMetadata?
  sources        AssetSource[]
  ingestionFiles IngestionFile[]
  attempts       ProcessingAttempt[]

  @@index([status])
  @@index([contentHash])
}

model AssetSource {
  id              String        @id @default(cuid())
  assetId         String
  ingestionFileId String        @unique
  sourceType      String        @default("GOOGLE_DRIVE")
  externalId      String
  folderPath      String?
  filename        String
  createdAt       DateTime      @default(now())
  linkReason      String?
  asset           Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ingestionFile   IngestionFile @relation(fields: [ingestionFileId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([sourceType, externalId])
}

model AssetMetadata {
  id                    String   @id @default(cuid())
  assetId               String   @unique
  caption               String
  objects               String[]
  actions               String[]
  styles                String[]
  colors                String[]
  background            String?
  composition           String?
  orientation           String?
  ageGroups             String[]
  educationalUses       String[]
  searchKeywords        String[]
  searchDescription     String
  searchDescriptionHash String
  rawResponse           Json?
  provider              String   @default("gemini")
  model                 String   @default("gemini-2.5-flash")
  modelVersion          String   @default("1.0")
  promptVersion         String   @default("1.0")
  metadataVersion       Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  grades                String[] @default([])
  asset                 Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([searchDescriptionHash])
}

model AssetEmbedding {
  id               String                 @id @default(cuid())
  assetId          String
  provider         String                 @default("openai")
  model            String                 @default("text-embedding-3-small")
  dimensions       Int                    @default(1536)
  sourceTextHash   String
  embeddingVersion Int                    @default(1)
  vector           Unsupported("vector")?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  asset            Asset                  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([sourceTextHash])
}

model ProcessingAttempt {
  id              String         @id @default(cuid())
  assetId         String?
  ingestionFileId String?
  stage           AssetState
  attemptNumber   Int            @default(1)
  status          String
  errorCode       String?
  errorMessage    String?
  stackTrace      String?
  durationMs      Int?
  sqsMessageId    String?
  createdAt       DateTime       @default(now())
  asset           Asset?         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ingestionFile   IngestionFile? @relation(fields: [ingestionFileId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([ingestionFileId])
  @@index([stage])
}

model AiUsage {
  id                String    @id @default(cuid())
  assetId           String?
  stage             String
  provider          String
  model             String
  requestId         String?
  startedAt         DateTime
  completedAt       DateTime?
  latencyMs         Int?
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  estimatedCost     Float?
  status            String
  retryCount        Int       @default(0)
  errorType         String?
  createdAt         DateTime  @default(now())
  cachedInputTokens Int?
  asset             Asset?    @relation(fields: [assetId], references: [id])

  @@index([assetId])
  @@index([stage])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

/// Layout-only flashcard template. Never stores educational content.
model FlashcardTemplate {
  id                 String                  @id @default(cuid())
  name               String
  description        String?
  supportedGrades    String[]                @default([])
  learningObjectives String[]
  subjectsSupported  String[]                @default([])
  difficultyLevels   String[]                @default([])
  templateVersion    String                  @default("1.0")
  active             Boolean                 @default(true)
  layoutDefinition   Json
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  templateType       String
  layoutType         String
  supportedAgeGroups String[]
  tags               String[]                @default([])
  pageSize           String                  @default("A6")
  orientation        String                  @default("PORTRAIT")
  thumbnail          String?
  selectionRules     TemplateSelectionRule[]

  @@unique([name, templateVersion])
  @@index([active])
  @@index([templateType])
  @@index([layoutType])
  @@index([supportedAgeGroups])
}

/// Configurable, deterministic template selection rules (no hardcoded age?template chains).
model TemplateSelectionRule {
  id                 String            @id @default(cuid())
  name               String
  priority           Int               @default(100)
  active             Boolean           @default(true)
  ageMin             Int?
  ageMax             Int?
  grades             String[]          @default([])
  subjects           String[]          @default([])
  learningObjectives String[]          @default([])
  difficulties       String[]          @default([])
  intents            String[]          @default([])
  topics             String[]          @default([])
  templateId         String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  template           FlashcardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([active, priority])
  @@index([templateId])
}

/// Observability-only flashcard (and future workflow) pipeline execution.
model PipelineExecution {
  id              String                         @id @default(cuid())
  requestId       String
  correlationId   String
  workflowType    String
  currentStage    String?
  status          PipelineExecutionStatus        @default(running)
  startedAt       DateTime                       @default(now())
  completedAt     DateTime?
  totalDurationMs Int?
  metadata        Json?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  aiInvocations   PipelineAiInvocation[]
  imageSearches   PipelineImageSearchExecution[]
  stages          PipelineStageExecution[]

  @@index([requestId])
  @@index([correlationId])
  @@index([status])
  @@index([workflowType])
  @@index([createdAt])
}

model PipelineStageExecution {
  id            String                         @id @default(cuid())
  executionId   String
  stageName     String
  sequence      Int
  status        PipelineStageStatus            @default(pending)
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?
  retryCount    Int                            @default(0)
  metadata      Json?
  createdAt     DateTime                       @default(now())
  updatedAt     DateTime                       @updatedAt
  aiInvocations PipelineAiInvocation[]
  imageSearches PipelineImageSearchExecution[]
  execution     PipelineExecution              @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId, sequence])
  @@index([executionId, stageName])
  @@index([status])
}

model PipelineAiInvocation {
  id                String                  @id @default(cuid())
  executionId       String
  stageExecutionId  String?
  provider          String
  model             String
  purpose           String
  startedAt         DateTime
  completedAt       DateTime?
  durationMs        Int?
  retryCount        Int                     @default(0)
  status            String
  promptHash        String?
  responseHash      String?
  inputTokens       Int?
  outputTokens      Int?
  totalTokens       Int?
  estimatedCost     Float?
  promptPayload     Json?
  responsePayload   Json?
  createdAt         DateTime                @default(now())
  cachedInputTokens Int?
  execution         PipelineExecution       @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stageExecution    PipelineStageExecution? @relation(fields: [stageExecutionId], references: [id])

  @@index([executionId])
  @@index([stageExecutionId])
  @@index([status])
  @@index([provider])
}

model PipelineImageSearchExecution {
  id               String                  @id @default(cuid())
  executionId      String
  stageExecutionId String?
  query            String
  filters          Json?
  durationMs       Int?
  resultCount      Int                     @default(0)
  selectedAssetId  String?
  cacheHit         Boolean                 @default(false)
  failed           Boolean                 @default(false)
  errorMessage     String?
  createdAt        DateTime                @default(now())
  execution        PipelineExecution       @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stageExecution   PipelineStageExecution? @relation(fields: [stageExecutionId], references: [id])

  @@index([executionId])
  @@index([stageExecutionId])
  @@index([selectedAssetId])
}

enum JobState {
  CREATED
  SCANNING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum AssetState {
  DISCOVERED
  DOWNLOADING
  VALIDATING
  HASHING
  DUPLICATE_CHECK
  UPLOADING_TO_S3
  STORED_IN_S3
  GENERATING_METADATA
  METADATA_GENERATED
  GENERATING_EMBEDDING
  EMBEDDING_GENERATED
  COMPLETED
  FAILED
  RETRY_PENDING
  DEAD_LETTER
}

enum PipelineExecutionStatus {
  running
  completed
  failed
  cancelled
}

enum PipelineStageStatus {
  pending
  running
  completed
  failed
  skipped
  cancelled
}
