// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum JobState {
  CREATED
  SCANNING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum AssetState {
  DISCOVERED
  DOWNLOADING
  VALIDATING
  HASHING
  DUPLICATE_CHECK
  UPLOADING_TO_S3
  STORED_IN_S3
  GENERATING_METADATA
  METADATA_GENERATED
  GENERATING_EMBEDDING
  EMBEDDING_GENERATED
  COMPLETED
  FAILED
  RETRY_PENDING
  DEAD_LETTER
}

model IngestionJob {
  id              String    @id @default(cuid())
  sourceType      String    @default("GOOGLE_DRIVE")
  rootFolderId    String
  mode            String    @default("FULL")
  status          JobState  @default(CREATED)
  totalDiscovered Int       @default(0)
  totalProcessed  Int       @default(0)
  totalSuccessful Int       @default(0)
  totalSkipped    Int       @default(0)
  totalFailed     Int       @default(0)
  totalDuplicate  Int       @default(0)
  expectedGeminiCalls    Int?
  expectedEmbeddingCalls Int?
  estimatedGeminiCostUsd Float?
  estimatedOpenAiCostUsd Float?
  estimatedTotalCostUsd  Float?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  files IngestionFile[]

  @@index([status])
  @@index([createdAt])
}

model IngestionFile {
  id                 String       @id @default(cuid())
  jobId              String
  job                IngestionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  driveFileId        String
  filename           String
  mimeType           String?
  fileSize           BigInt?
  folderPath         String?
  driveFileCreatedAt DateTime?
  status             AssetState   @default(DISCOVERED)
  errorMessage       String?
  assetId            String?
  asset              Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  assetSource AssetSource?
  attempts    ProcessingAttempt[]

  @@unique([jobId, driveFileId])
  @@index([driveFileId])
  @@index([status])
  @@index([assetId])
}

model Asset {
  id          String     @id @default(cuid())
  contentHash String     @unique
  mimeType    String
  fileSize    BigInt
  width       Int?
  height      Int?
  s3Bucket    String
  s3ObjectKey String
  status      AssetState @default(STORED_IN_S3)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  sources        AssetSource[]
  ingestionFiles IngestionFile[]
  metadata       AssetMetadata?
  embeddings     AssetEmbedding[]
  attempts       ProcessingAttempt[]
  aiUsages       AiUsage[]

  @@index([status])
  @@index([contentHash])
}

model AssetSource {
  id              String        @id @default(cuid())
  assetId         String
  asset           Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ingestionFileId String        @unique
  ingestionFile   IngestionFile @relation(fields: [ingestionFileId], references: [id], onDelete: Cascade)
  sourceType      String        @default("GOOGLE_DRIVE")
  externalId      String
  folderPath      String?
  filename        String
  linkReason      String?
  createdAt       DateTime      @default(now())

  @@index([assetId])
  @@index([sourceType, externalId])
}

model AssetMetadata {
  id                    String   @id @default(cuid())
  assetId               String   @unique
  asset                 Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  caption               String
  objects               String[]
  actions               String[]
  styles                String[]
  colors                String[]
  background            String?
  composition           String?
  orientation           String?
  ageGroups             String[]
  grades                String[] @default([])
  educationalUses       String[]
  searchKeywords        String[]
  searchDescription     String
  searchDescriptionHash String
  rawResponse           Json?
  provider              String   @default("gemini")
  model                 String   @default("gemini-2.5-flash")
  modelVersion          String   @default("1.0")
  promptVersion         String   @default("1.0")
  metadataVersion       Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([searchDescriptionHash])
}

model AssetEmbedding {
  id               String                       @id @default(cuid())
  assetId          String
  asset            Asset                        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  provider         String                       @default("openai")
  model            String                       @default("text-embedding-3-small")
  dimensions       Int                          @default(1536)
  sourceTextHash   String
  embeddingVersion Int                          @default(1)
  vector           Unsupported("vector(1536)")?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@index([assetId])
  @@index([sourceTextHash])
}

model ProcessingAttempt {
  id              String         @id @default(cuid())
  assetId         String?
  asset           Asset?         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ingestionFileId String?
  ingestionFile   IngestionFile? @relation(fields: [ingestionFileId], references: [id], onDelete: Cascade)
  stage           AssetState
  attemptNumber   Int            @default(1)
  status          String
  errorCode       String?
  errorMessage    String?
  stackTrace      String?
  durationMs      Int?
  sqsMessageId    String?
  createdAt       DateTime       @default(now())

  @@index([assetId])
  @@index([ingestionFileId])
  @@index([stage])
}

model AiUsage {
  id             String   @id @default(cuid())
  assetId        String?
  asset          Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  stage          String
  provider       String
  model          String
  requestId      String?
  startedAt      DateTime
  completedAt    DateTime?
  latencyMs      Int?
  inputTokens    Int?
  outputTokens   Int?
  totalTokens    Int?
  estimatedCost  Float?
  status         String
  retryCount     Int      @default(0)
  errorType      String?
  createdAt      DateTime @default(now())

  @@index([assetId])
  @@index([stage])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

/// Layout-only flashcard template. Never stores educational content.
model FlashcardTemplate {
  id                   String   @id @default(cuid())
  name                 String
  description          String?
  supportedAgeMin      Int
  supportedAgeMax      Int
  supportedGrades      String[] @default([])
  learningObjectives   String[]
  subjectsSupported    String[] @default([])
  difficultyLevels     String[] @default([])
  templateVersion      String   @default("1.0")
  active               Boolean  @default(true)
  layoutDefinition     Json
  editableComponents   Json
  componentHierarchy   Json
  componentConstraints Json?
  renderingHints       Json?
  defaultStyles        Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  selectionRules TemplateSelectionRule[]

  @@index([active])
  @@index([supportedAgeMin, supportedAgeMax])
  @@unique([name, templateVersion])
}

/// Configurable, deterministic template selection rules (no hardcoded age→template chains).
model TemplateSelectionRule {
  id                 String   @id @default(cuid())
  name               String
  priority           Int      @default(100)
  active             Boolean  @default(true)
  ageMin             Int?
  ageMax             Int?
  grades             String[] @default([])
  subjects           String[] @default([])
  learningObjectives String[] @default([])
  difficulties       String[] @default([])
  intents            String[] @default([])
  topics             String[] @default([])
  templateId         String
  template           FlashcardTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([active, priority])
  @@index([templateId])
}
