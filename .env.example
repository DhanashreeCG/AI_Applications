# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/ai_assets_db?schema=public"

# Application Settings
NODE_ENV="development"
PORT=3000

# AWS S3 & SQS Configuration
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_S3_BUCKET_NAME="ai-asset-ingestion-bucket"
AWS_SQS_INGESTION_QUEUE_URL="https://sqs.us-east-1.amazonaws.com/123456789012/ingestion-queue"
AWS_SQS_S3_UPLOAD_QUEUE_URL="https://sqs.us-east-1.amazonaws.com/123456789012/s3-upload-queue"
AWS_SQS_AI_METADATA_QUEUE_URL="https://sqs.us-east-1.amazonaws.com/123456789012/ai-metadata-queue"
AWS_SQS_EMBEDDING_QUEUE_URL="https://sqs.us-east-1.amazonaws.com/123456789012/embedding-queue"
AWS_SQS_DLQ_URL="https://sqs.us-east-1.amazonaws.com/123456789012/dlq-queue"

# Redis Cache
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_ENABLED="true"
REDIS_SEARCH_CACHE_TTL_SECONDS=300
REDIS_ASSET_METADATA_CACHE_TTL_SECONDS=3600

# Google Drive Credentials
# Recommended: point to the downloaded service account JSON file (avoids PEM escaping issues on Windows)
GOOGLE_DRIVE_CREDENTIALS_PATH=""
GOOGLE_DRIVE_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_DRIVE_API_KEY=""

# AI Provider API Keys
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_PROMPT_VERSION="v1"
OPENAI_API_KEY="your_openai_api_key"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# AI Cost Estimation (USD per call; tune to your billing)
AI_COST_GEMINI_PER_IMAGE=0.001
AI_COST_OPENAI_EMBEDDING_PER_CALL=0.00002

# Provider Rate Limits & Circuit Breaker
GEMINI_MAX_RPS=2
OPENAI_MAX_RPS=10
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_MS=60000

# Pipeline Retry & DLQ
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_BACKOFF_BASE_SECONDS=30
PIPELINE_BACKOFF_MAX_SECONDS=900

# SQS Worker Runtime
SQS_WORKER_ENABLED=true
SQS_WORKER_POLL_WAIT_SECONDS=20
SQS_WORKER_CONCURRENCY=4
SQS_WORKER_SHUTDOWN_TIMEOUT_MS=30000
# Must exceed max stage time (download + Gemini + embedding + margin)
SQS_VISIBILITY_TIMEOUT_SECONDS=900
