# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/ai_assets_db?schema=public"

# Application Settings
NODE_ENV="development"
PORT=3000

# AWS S3 Configuration (storage only — queue is BullMQ)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_S3_BUCKET_NAME="ai-asset-ingestion-bucket"

# Redis (required for BullMQ job queues; also used for search cache)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_ENABLED="true"
REDIS_SEARCH_CACHE_TTL_SECONDS=300
REDIS_ASSET_METADATA_CACHE_TTL_SECONDS=3600

# BullMQ / Queue Worker Runtime
QUEUE_WORKER_ENABLED=true
QUEUE_WORKER_CONCURRENCY=4
QUEUE_WORKER_LOCK_DURATION_MS=900000
QUEUE_WORKER_SHUTDOWN_TIMEOUT_MS=30000
BULLMQ_PREFIX=asset-ingestion

# Google Drive Credentials
# Recommended: point to the downloaded service account JSON file (avoids PEM escaping issues on Windows)
GOOGLE_DRIVE_CREDENTIALS_PATH=""
GOOGLE_DRIVE_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_DRIVE_API_KEY=""

# AI Provider API Keys
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_PROMPT_VERSION="v1"
OPENAI_API_KEY="your_openai_api_key"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Flashcard content generation provider: "gemini" | "openai"
# Vision metadata uses GEMINI_MODEL; flashcard content uses FLASHCARD_*_MODEL below.
FLASHCARD_CONTENT_PROVIDER="gemini"
FLASHCARD_GEMINI_MODEL="gemini-2.5-flash"
OPENAI_FLASHCARD_MODEL="gpt-4o-mini"

# AI Cost Estimation (USD per call; tune to your billing)
AI_COST_GEMINI_PER_IMAGE=0.001
AI_COST_OPENAI_EMBEDDING_PER_CALL=0.00002

# Provider Rate Limits & Circuit Breaker
GEMINI_MAX_RPS=2
OPENAI_MAX_RPS=10
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_MS=60000

# Pipeline Retry & DLQ
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_BACKOFF_BASE_SECONDS=30
PIPELINE_BACKOFF_MAX_SECONDS=900

# Flashcards
# Ranked hits per LLM image query (one search). Later cards take 2nd/3rd if top is already used.
FLASHCARD_IMAGE_SEARCH_LIMIT=8
FLASHCARD_IMAGE_CONCURRENCY=3
# Retry the same LLM query only when the embedding/search call fails (not a rewritten query).
FLASHCARD_IMAGE_EMBEDDING_MAX_ATTEMPTS=3
FLASHCARD_IMAGE_EMBEDDING_RETRY_DELAY_MS=200

# Content restrictions: lists live in DB table ContentRestrictionTerm.
# Default region for the LLM when the request omits countryCode (ISO 3166-1 alpha-2).
# Server-side only. Request body `countryCode` or header `x-country-code` overrides this.
FLASHCARD_DEFAULT_COUNTRY_CODE=
# Input-guard ratio: banned-term tokens / query tokens. No word-count bypass.
CONTENT_RESTRICTION_INPUT_RATIO=0.2

# AI template selection (runs when templateId is omitted)
# Provider: "openai" (default, prompt caching) | "gemini"
FLASHCARD_TEMPLATE_SELECTION_AI_ENABLED=true
FLASHCARD_TEMPLATE_SELECTION_PROVIDER=openai
FLASHCARD_TEMPLATE_SELECTION_OPENAI_MODEL=gpt-4.1-mini
FLASHCARD_TEMPLATE_SELECTION_GEMINI_MODEL=gemini-2.5-flash
FLASHCARD_TEMPLATE_SELECTION_MIN_CONFIDENCE=0.5
FLASHCARD_TEMPLATE_SELECTION_TIMEOUT_MS=6000
FLASHCARD_TEMPLATE_SELECTION_CATALOG_TTL_MS=600000
# Estimated USD per million tokens (OpenAI gpt-4.1-mini defaults)
FLASHCARD_TEMPLATE_SELECTION_COST_PER_M_INPUT_USD=0.4
FLASHCARD_TEMPLATE_SELECTION_COST_PER_M_CACHED_INPUT_USD=0.1
FLASHCARD_TEMPLATE_SELECTION_COST_PER_M_OUTPUT_USD=1.6

# Flashcard server-side renderer (Playwright WebP/PDF + local/S3 storage)
# When false: POST /flashcards/generate returns JSON only (skips Playwright + storage).
# Existing renderer code remains; set true to re-enable generate-time render and POST /flashcards/render.
FLASHCARD_RENDERER_ENABLED=false
FLASHCARD_RENDERER_STORAGE_BACKEND=local
FLASHCARD_RENDERER_STORAGE_ROOT=storage/flashcards
FLASHCARD_RENDERER_S3_KEY_PREFIX=flashcards/rendered
# FLASHCARD_RENDERER_S3_BUCKET=
FLASHCARD_RENDERER_SIGNED_URL_TTL_SECONDS=3600
FLASHCARD_RENDERER_CONCURRENCY=4
# Origin Playwright uses to load public/flashcards.html and card images (must be this Nest server).
FLASHCARD_RENDERER_API_BASE_URL=http://127.0.0.1:3000

# Static HTML on nginx: set FLASHCARDS_API_URL / WORKSHEETS_API_URL in public/env-config.js
# to this Nest origin. Leave them empty when Nest itself serves /public.

# Worksheet UI + APIs (empty WORKSHEET_API_BASE_URL = same origin as the page)
WORKSHEET_API_BASE_URL=
WORKSHEET_API_PREFIX=/worksheets
WORKSHEET_ASSET_IMAGE_PATH=/worksheets/assets
WORKSHEET_PENCIL_ICON_URL=/pencil.png
WORKSHEET_GENERATE_COUNT_DEFAULT=1
WORKSHEET_GENERATE_COUNT_MAX=10
WORKSHEET_LIST_PAGE_SIZE=10
WORKSHEET_LIST_PAGE_SIZE_MAX=50
WORKSHEET_PAGER_MAX_BUTTONS=8
WORKSHEET_IMAGE_CONCURRENCY=3
WORKSHEET_IMAGE_SEARCH_LIMIT=1
WORKSHEET_IMAGE_PICKER_LIMIT=10
WORKSHEET_USER_UPLOAD_S3_PREFIX=worksheets/uploads
WORKSHEET_RENDER_WIDTH=1016
WORKSHEET_RENDER_HEIGHT=1316
# Playwright export only. Leave empty to avoid injecting a <base href> into preview HTML.
WORKSHEET_RENDERER_API_BASE_URL=
WORKSHEET_DEFAULT_AGE_GROUP=3-4
WORKSHEET_AGE_GROUPS='[{"id":"2-3","label":"2-3 years (FS 0)","age":3,"grade":"FS0"},{"id":"3-4","label":"3-4 years (FS 1)","age":4,"grade":"LKG"},{"id":"4-5","label":"4-5 years (FS 2)","age":5,"grade":"UKG"}]'

# Worksheet Template AI Selection
WORKSHEET_TEMPLATE_SELECTION_AI_ENABLED=true
WORKSHEET_TEMPLATE_SELECTION_PROVIDER=google-gemini
# WORKSHEET_TEMPLATE_SELECTION_PROVIDER=openai
WORKSHEET_TEMPLATE_SELECTION_OPENAI_MODEL=gpt-4o-mini
WORKSHEET_TEMPLATE_SELECTION_GEMINI_MODEL=gemini-2.5-flash
WORKSHEET_TEMPLATE_SELECTION_MIN_CONFIDENCE=0.5
WORKSHEET_TEMPLATE_SELECTION_TIMEOUT_MS=6000
WORKSHEET_TEMPLATE_SELECTION_COST_PER_M_INPUT_USD=0.075
WORKSHEET_TEMPLATE_SELECTION_COST_PER_M_CACHED_INPUT_USD=0.0375
WORKSHEET_TEMPLATE_SELECTION_COST_PER_M_OUTPUT_USD=0.30
