# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/ai_assets_db?schema=public"

# Application Settings
NODE_ENV="development"
PORT=3000

# AWS S3 Configuration (storage only — queue is BullMQ)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
AWS_S3_BUCKET_NAME="ai-asset-ingestion-bucket"

# Redis (required for BullMQ job queues; also used for search cache)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_ENABLED="true"
REDIS_SEARCH_CACHE_TTL_SECONDS=300
REDIS_ASSET_METADATA_CACHE_TTL_SECONDS=3600

# BullMQ / Queue Worker Runtime
QUEUE_WORKER_ENABLED=true
QUEUE_WORKER_CONCURRENCY=4
QUEUE_WORKER_LOCK_DURATION_MS=900000
QUEUE_WORKER_SHUTDOWN_TIMEOUT_MS=30000
BULLMQ_PREFIX=asset-ingestion

# Google Drive Credentials
# Recommended: point to the downloaded service account JSON file (avoids PEM escaping issues on Windows)
GOOGLE_DRIVE_CREDENTIALS_PATH=""
GOOGLE_DRIVE_CLIENT_EMAIL="service-account@project.iam.gserviceaccount.com"
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_DRIVE_API_KEY=""

# AI Provider API Keys
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_PROMPT_VERSION="v1"
OPENAI_API_KEY="your_openai_api_key"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Flashcard content generation provider: "gemini" | "openai"
# Vision metadata uses GEMINI_MODEL; flashcard content uses FLASHCARD_*_MODEL below.
FLASHCARD_CONTENT_PROVIDER="gemini"
FLASHCARD_GEMINI_MODEL="gemini-2.5-flash"
OPENAI_FLASHCARD_MODEL="gpt-4o-mini"

# AI Cost Estimation (USD per call; tune to your billing)
AI_COST_GEMINI_PER_IMAGE=0.001
AI_COST_OPENAI_EMBEDDING_PER_CALL=0.00002

# Provider Rate Limits & Circuit Breaker
GEMINI_MAX_RPS=2
OPENAI_MAX_RPS=10
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_COOLDOWN_MS=60000

# Pipeline Retry & DLQ
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_BACKOFF_BASE_SECONDS=30
PIPELINE_BACKOFF_MAX_SECONDS=900

# Flashcards
FLASHCARD_IMAGE_SEARCH_LIMIT=1
FLASHCARD_IMAGE_CONCURRENCY=3

# Flashcard server-side renderer (Playwright)
FLASHCARD_RENDERER_ENABLED=true
FLASHCARD_RENDERER_STORAGE_BACKEND=local
FLASHCARD_RENDERER_STORAGE_ROOT=storage/flashcards
FLASHCARD_RENDERER_S3_KEY_PREFIX=flashcards/rendered
# FLASHCARD_RENDERER_S3_BUCKET=
FLASHCARD_RENDERER_SIGNED_URL_TTL_SECONDS=3600
FLASHCARD_RENDERER_CONCURRENCY=4
FLASHCARD_RENDERER_API_BASE_URL=http://localhost:3000
